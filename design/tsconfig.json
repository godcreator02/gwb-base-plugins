{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // 浏览器半看不见 node 全局：不给空表的话 @types/node 会自动收进来
    "types": [],
    "noEmit": true,
    // shadcn 拉下来的组件写的是 @/… 这种。不写 baseUrl：TS 7 移除了它，
    // paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["src"]
}
