{
  "name": "gwb-base-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "doc": "pnpm --filter gwb-base-plugins-docs-site exec livedoc check",
    "doc:confirm": "pnpm --filter gwb-base-plugins-docs-site exec livedoc confirm"
  },
  "//devDeps": "tools/ 那两个构建脚本用的：件的浏览器半走 esbuild 打包，样式表走 tailwind + postcss 编译再 scope。件自己不装这些——构建线是仓里共享的一份，不做成包（消费方只有仓内的件，做成包过不了准入判据第二关）",
  "devDependencies": {
    "@godcreator02/gwb-tokens": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
