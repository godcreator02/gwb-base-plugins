{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // 只给 shadcn CLI 看：它读件根的 tsconfig 解析 components.json 里的 @/ 别名，
    // 据此决定把拉下来的组件放到哪。node 半自己一个 @/ 都不用。
    // 不写 baseUrl——TS 7 把它移除了（TS5102），paths 现在直接相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  // 只收 src/index.ts（其余 node 半文件靠 import 链带进来；本件 node 半就这一个文件）。
  // 写成 src/**/*.ts 的话浏览器半那几个文件会被 tsc 一起编到 dist/client/ 下——
  // 那些是 esbuild 的输入，不是产物
  "include": ["src/index.ts"]
}
