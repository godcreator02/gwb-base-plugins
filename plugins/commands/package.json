{
  "name": "@godcreator/gwb-commands",
  "version": "0.5.0",
  "author": {
    "name": "godcreator"
  },
  "description": "命令总线：插件把能力登记成「命令名 → 处理函数」的表，页面、agent 与其他插件经同一张表调用（agent 经 MCP 入口的 index / search / run）。服务 gwbCommands；skill 1 份；命令 0 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ],
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.7.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  }
}
