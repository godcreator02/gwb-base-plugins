{
  "name": "@godcreator/gwb-commands",
  "version": "0.6.2",
  "author": {
    "name": "godcreator"
  },
  "description": "命令总线：插件把能力登记成「命令名 → 处理函数」的表，页面、agent 与其他插件经同一张表调用（agent 经 MCP 入口的 index / search / run）。服务 gwbCommands；skill 1 份；命令 0 条。",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ],
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
