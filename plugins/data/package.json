{
  "name": "@godcreator/gwb-data",
  "version": "0.1.11",
  "author": {
    "name": "godcreator"
  },
  "description": "插件的数据：每个插件的文档存放在 <home>/data/<条目 id>/ 下，一份文档一个 JSON 文件，原子写入。服务 gwbData；skill 0 份；命令 0 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.9.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
