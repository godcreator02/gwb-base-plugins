{
  "name": "@godcreator/gwb-data",
  "version": "0.1.7",
  "author": {
    "name": "godcreator"
  },
  "description": "插件的数据：每个插件的文档存放在 <home>/data/<条目 id>/ 下，一份文档一个 JSON 文件，原子写入。服务 gwbData；skill 0 份；命令 0 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.4.1",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "^0.4.1",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "gwb": {
    "provides": {
      "gwbData": {
        "summary": "插件写进文件的状态：<home>/data/<条目末段>/，一份文档一个 JSON",
        "usage": "readDoc(doc)（不存在或读坏了返回 undefined，第一次读要自己处理这种情况）· writeDoc(doc, value)（整份替换、原子写入）· dir（存非 JSON 文件用它，别自己拼路径）· owners()/transferOwner(id, pkg)（包改名后接上旧数据）；inject ['gwbData']"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
