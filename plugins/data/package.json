{
  "name": "@godcreator/gwb-data",
  "version": "0.1.2",
  "author": {"name": "godcreator"},
  "description": "件的数据：把自己的东西落到 <home>/data/<条目 id>/ 下，一份文档一个 JSON、原子落盘。服务 gwbData；skill 0 份；命令 0 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 只跑 typecheck/lint/test **不构建**,少了这条就会把上一版的 dist 原样发出去——而且是静默的",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-repo-kit": "0.2.2",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
