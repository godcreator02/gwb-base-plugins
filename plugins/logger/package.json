{
  "name": "@godcreator/gwb-logger",
  "version": "0.4.5",
  "author": {
    "name": "godcreator"
  },
  "description": "日志插件（core）：登记第二个 cordis exporter，收下内核、插件、页面三方的全部日志，自己缓存最近两千条，经内核的 emit 实时推给页面；日志窗格在 gwb-baseui。服务 gwbLogger（上面刻意没有方法）；skill 0 份；命令 2 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "gwb": {
    "provides": {
      "gwbLogger": {
        "summary": "日志插件的占位服务——上面刻意没有方法，别调用",
        "usage": "插件写日志用 ctx.logger('<插件名>')，自动进 gwb.log、日志窗格与 logger.backlog；日志窗格这类使用方 inject ['gwbLogger'] 只为等它出现"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.4.1",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "workspace:*",
    "@godcreator/gwb-plugin-api": "^0.4.1",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
