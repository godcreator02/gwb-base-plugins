{
  "name": "@godcreator/gwb-logger",
  "version": "0.4.10",
  "author": {
    "name": "godcreator"
  },
  "description": "日志插件（core）：在 cordis 日志流上注册第三个 exporter（前两个是 cordis 自带的缓冲与内核写 gwb.log 的那个），收下内核、插件、页面三方的全部日志，自己缓存最近两千条，经内核的 emit 实时推给页面；日志窗格在 gwb-baseui。服务 gwbLogger（上面刻意没有方法）；skill 0 份；命令 2 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.9.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
