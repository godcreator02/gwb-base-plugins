{
  "name": "@godcreator/gwb-logger",
  "version": "0.4.10",
  "author": {
    "name": "godcreator"
  },
  "description": "日志插件（core）：只读内核写的日志文件 <home>/gwb.log（一行一个 JSON，含轮转出的 gwb.log.1），经命令 logger.query 按级别、logger 名、子串筛，取最近几条或某个位置之后新写的；日志窗格在 gwb-baseui。服务无；skill 0 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.9.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
