{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // 只给 shadcn CLI 看：它读件根的 tsconfig 解析 components.json 里的 @/ 别名，
    // 据此决定把拉下来的组件放到哪。node 半自己一个 @/ 都不用。
    // 漏了这段的下场是组件被放进一个**字面叫 `@` 的目录**。
    // **不写 baseUrl**——TS 7 把它移除了（TS5102），paths 现在直接相对本文件所在目录解析
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  // **只收 src/index.ts**。浏览器半那几个文件（含 src/catalog.ts，它只有那一半在用）
  // 写成 src/**/*.ts 的话会被 tsc 一起编到 dist/ 下——那些是 esbuild 的输入，不是产物
  "include": ["src/index.ts"]
}
