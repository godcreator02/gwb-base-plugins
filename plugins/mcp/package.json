{
  "name": "@godcreator/gwb-mcp",
  "version": "0.10.8",
  "author": {
    "name": "godcreator"
  },
  "description": "MCP 入口：把命令总线提供给 agent——工具只有 index / search / run 三个（加一个工具是 major 变更），无状态 streamableHTTP、要 Authorization token（每个 home 一份、写在磁盘上、重启不换），default 固定用 2870 端口；index 只列说明书与命令名，装了哪些插件问 plugin-manager.list。另带一个零依赖的命令行客户端（mcp.client），给没有 MCP 客户端的环境用。服务无；skill 1 份；命令 3 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "instructions.md",
    "skills"
  ],
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.7.0",
    "@godcreator/gwb-node-cli": "workspace:^",
    "@godcreator/gwb-settings": "workspace:^",
    "@godcreator/gwb-skills": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-node-cli": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
