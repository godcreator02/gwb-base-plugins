{
  "name": "@godcreator/gwb-mcp",
  "version": "0.12.0",
  "author": {
    "name": "godcreator"
  },
  "description": "MCP 入口：工具只有 index / search / run 三个，无状态 streamableHTTP、凭据由每个 home 独立保管，default 固定用 2870 端口。支持不回显的临时凭据签发、到期检查与撤销，客户端接线由 onboard skill 编排；自带零依赖命令行客户端，--home 读取对应入口与凭据。服务无；skill 1 份；命令 6 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "instructions.md",
    "skills"
  ],
  "scripts": {
    "build": "node build.ts && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-node-cli": "workspace:^",
    "@godcreator/gwb-settings": "workspace:^",
    "@godcreator/gwb-skills": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-node-cli": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
