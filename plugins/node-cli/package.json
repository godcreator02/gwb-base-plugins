{
  "name": "@godcreator/gwb-node-cli",
  "version": "0.5.1",
  "author": {
    "name": "godcreator"
  },
  "description": "运行 node 写的命令行工具：插件把自己构建出来的 cli.js 登记进来，由它启动进程、收集输出、到时限结束进程；登记的命令自动转登记成总线命令。服务 gwbNodeCli；skill 1 份；命令 1 条。",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "workspace:^",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
