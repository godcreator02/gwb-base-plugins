{
  "name": "@godcreator/gwb-node-cli",
  "version": "0.4.3",
  "author": {
    "name": "godcreator"
  },
  "description": "跑 node 写的 CLI：件把自己编出来的 cli.js 登记进来，起进程、收输出、按时限收尾都归它；登记的命令自动镜像成总线命令。服务 gwbNodeCli；skill 1 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 只跑 typecheck/lint/test **不构建**,少了这条就会把上一版的 dist 原样发出去——而且是静默的",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "workspace:*",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-repo-kit": "0.2.3",
    "@godcreator/gwb-skills": "workspace:*",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
