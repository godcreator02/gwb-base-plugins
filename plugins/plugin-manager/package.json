{
  "name": "@godcreator/gwb-plugin-manager",
  "version": "0.5.2",
  "author": {
    "name": "godcreator"
  },
  "description": "插件管理：管 home 里的包与 cordis.yml 条目——装卸检升、一键热升、加删条目、启停；装完跑 peers check，对不上的每一处进回执 peerWarnings。服务 gwbPluginManager；skill 1 份；命令 14 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.md",
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 只跑 typecheck/lint/test **不构建**,少了这条就会把上一版的 dist 原样发出去——而且是静默的",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "workspace:*",
    "@godcreator/gwb-data": "workspace:*",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-settings": "workspace:*",
    "@godcreator/gwb-skills": "workspace:*",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
