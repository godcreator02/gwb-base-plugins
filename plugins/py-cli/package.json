{
  "name": "@godcreator/gwb-py-cli",
  "version": "0.3.3",
  "author": {
    "name": "godcreator"
  },
  "description": "跑 python 写的 CLI：在消费方件的包根下用 uv 建 venv、spawn 里面的可执行文件（件本身不带 python 项目）。服务 gwbPyCli；skill 1 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.md",
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "//prepublishOnly": "发版前强制构建一次。pnpm check 只跑 typecheck/lint/test **不构建**,少了这条就会把上一版的 dist 原样发出去——而且是静默的",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "^0.4.3",
    "@godcreator/gwb-plugin-api": "^0.1.2",
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "workspace:*",
    "@godcreator/gwb-plugin-api": "0.1.2",
    "@godcreator/gwb-skills": "workspace:*",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": ["gwb", "gwb-plugin"]
}
