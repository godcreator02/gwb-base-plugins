{
  "name": "@godcreator/gwb-py-cli",
  "version": "0.3.7",
  "author": {
    "name": "godcreator"
  },
  "description": "运行 python 写的命令行工具：在调用方插件的包根下用 uv 建 venv、启动里面的可执行文件（本插件自己不带 python 项目）。服务 gwbPyCli；skill 1 份；命令 1 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.4.1",
    "cordis": "^4.0.0-rc.10"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "workspace:*",
    "@godcreator/gwb-plugin-api": "^0.4.1",
    "@godcreator/gwb-skills": "workspace:*",
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "gwb": {
    "provides": {
      "gwbPyCli": {
        "summary": "登记随包发的 python 命令行工具，venv 不在时当场用 uv 重建",
        "usage": "register({ name, description?, usage?, packageRoot, distName, version, command?|module?, args?, cwd?, env?, timeoutMs? })；ensureReady({ packageRoot, distName, version }) 检查并补齐 venv，重复调用结果相同；run 与 gwbNodeCli 的 run 形状相同；inject ['gwbPyCli']"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
