{
  "name": "@godcreator/gwb-settings",
  "version": "0.3.5",
  "author": {
    "name": "godcreator"
  },
  "description": "设置：插件声明自己有哪些设置项，值写进 <home>/settings.json；shared 项写进公共区；secret 项在 settings.all 的回执里只回是否已设置、不回值（文件里仍是明文，要取值按位置调 settings.get）。服务 gwbSettings；skill 1 份；命令 4 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.7.0",
    "@godcreator/gwb-skills": "workspace:^",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-commands": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
