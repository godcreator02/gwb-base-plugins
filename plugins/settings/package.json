{
  "name": "@godcreator/gwb-settings",
  "version": "0.4.0",
  "author": {
    "name": "godcreator"
  },
  "description": "设置与凭据：每个 home 的普通设置与声明存在 settings.json，secret 明文存在 credentials.json；凭据可不回显地查状态、复制、导入、生成，插件内部照常取用，本地界面可查看。服务 gwbSettings；skill 1 份。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "workspace:^",
    "cordis": "^4.0.0-rc.10"
  },
  "peerDependenciesMeta": {
    "@godcreator/gwb-commands": {
      "optional": true
    },
    "@godcreator/gwb-skills": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
