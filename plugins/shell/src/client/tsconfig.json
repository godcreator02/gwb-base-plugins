{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    // 浏览器半看不见 node 全局：不给空表的话 @types/node 会自动收进来，
    // 写一句 process.env 也不报错,而束里根本没有它
    "types": [],
    "noEmit": true,
    // shadcn 拉下来的组件写的是 @/… 这种,typecheck 得解析得了。
    // 不写 baseUrl:TS 7 移除了它,paths 相对本文件所在目录解析
    "paths": {
      "@/*": ["./*"]
    }
  },
  // 那几个纯逻辑模块住 src/（node 半也用得着），浏览器半 import 它们，
  // tsc 顺着 import 自己拉进来
  "include": ["."]
}
