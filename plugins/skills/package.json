{
  "name": "@godcreator/gwb-skills",
  "version": "0.4.4",
  "author": {
    "name": "godcreator"
  },
  "description": "说明书：谁有说明书谁自己挂上来，按名收集与查询；说明书是全局单一命名空间，撞名的那份不挂。服务 gwbSkills；skill 0 份；命令 2 条。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-plugin-api": "^0.2.7",
    "cordis": "^4.0.0-rc.9"
  },
  "devDependencies": {
    "@godcreator/gwb-commands": "^0.4.6",
    "@godcreator/gwb-plugin-api": "^0.2.7",
    "@godcreator/gwb-repo-kit": "0.3.0",
    "cordis": "4.0.0-rc.9",
    "typescript": "^7.0.2"
  },
  "gwb": {
    "provides": {
      "gwbSkills": {
        "summary": "挂随包发的说明书（给 agent 读的流程文档），全局单一命名空间",
        "usage": "register(dir: string | URL)——目录下每个子目录一份 SKILL.md，回注销函数（自动摘，不用包 effect）；目录必须进 package.json 的 files 白名单，漏了装上才炸；局部 ctx.inject 即可，缺了主件照挂"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://git.tianshen02.online:28377/godcreator/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb",
    "gwb-plugin"
  ]
}
