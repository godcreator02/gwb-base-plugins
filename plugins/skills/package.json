{
  "name": "@godcreator/gwb-skills",
  "version": "0.4.14",
  "author": {
    "name": "godcreator"
  },
  "description": "说明书：有说明书的插件自己登记进来，按名收集与查询；说明书名全局唯一，重名的那份不登记。服务 gwbSkills；skill 0 份；命令 2 条。",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@godcreator/gwb-commands": "workspace:^",
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "cordis": "^4.0.0-rc.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.10",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/godcreator02/gwb-base-plugins.git"
  },
  "keywords": [
    "gwb-plugin"
  ]
}
